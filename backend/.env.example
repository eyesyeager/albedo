# 复制为 backend/.env 后填写真实值；该文件已被根 .gitignore 忽略，切勿提交。
# 密码中的 @ ! 等特殊字符必须做 URL 编码（urllib.parse.quote）。
# 源码不提供任何可用默认凭据；DEMO_ACCESS_KEY / SECRET_KEY 必须显式配置。
# 业务可调参数（枚举、默认值、限额、运行时参数）存放在数据库 system_configs 表，
# 通过 GET/PATCH /api/v1/settings/configs 或工作区 bootstrap 读取，不在此处配置。
DATABASE_URL=mysql+aiomysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/albedo
REDIS_URL=redis://:URL_ENCODED_PASSWORD@HOST:PORT/0
SECRET_KEY=REPLACE_WITH_FERNET_GENERATE_KEY_OUTPUT
DEMO_ACCESS_KEY=
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=REPLACE_WITH_REAL_KEY
LLM_MODEL=your-model-id
LLM_TIMEOUT_SECONDS=60
# 图片理解工具使用的多模态模型，留空则复用 LLM_MODEL
VISION_MODEL=
CHECKPOINT_BACKEND=redis
# Skill 包对象存储（腾讯云 COS）。生产环境 SKILL_STORAGE=cos 时密钥必填，切勿提交 .env。
# 本地开发未配置密钥时会在 dev 环境降级为本地目录并输出告警日志。
SKILL_STORAGE=cos
COS_BUCKET=albedo-1305182252
COS_REGION=ap-nanjing
COS_SECRET_ID=
COS_SECRET_KEY=
# STS 临时密钥场景填写；长期密钥留空
COS_TOKEN=
# 自定义访问域名（内网/测试），留空使用官方域名
COS_ENDPOINT=
COS_SCHEME=https
COS_PREFIX=skills
COS_TIMEOUT_SECONDS=30
# 对外发布地址与允许的前端来源（生产环境必须按实际域名修改）
PLATFORM_DOMAIN=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
CSRF_ENABLED=false
ENVIRONMENT=dev
# 非 dev 环境强制要求：SECRET_KEY 合法且非空、DEMO_ACCESS_KEY 非演示值、
# DATABASE_URL 指向真实实例、LLM_API_KEY/LLM_MODEL 已配置真实上游、
# COOKIE_SECURE=true、CSRF_ENABLED=true、CORS_ORIGINS 不含通配符，否则启动失败。
