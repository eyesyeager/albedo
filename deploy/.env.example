# Docker Compose 后端部署配置样例（前端静态资源由你自己的网关/托管层负责）。
# 用法：cp deploy/.env.example deploy/.env，编辑后用
#       docker compose --env-file deploy/.env up -d --build
# 该文件含真实凭据，已被 .gitignore 排除，切勿提交。

# ==================== 后端 API 暴露 ====================
# 默认只绑定回环，供同机前端网关反代；网关在其它机器上时改为 0.0.0.0，
# 并务必用防火墙/安全组限制来源，不要把数据库与后端裸端口暴露到公网。
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# ==================== MySQL（compose 内置实例）====================
# 用外部 MySQL 时只需把 DATABASE_URL 指向外部地址，内置实例可保留不用。
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=albedo
MYSQL_USER=albedo
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# ==================== Redis（compose 内置实例）====================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ==================== 后端必需 ====================
# 生成：python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 必须固定并备份：轮换后已加密的 MCP headers/env、凭据将不可解密。
SECRET_KEY=
# 管理面初始访问 Key，不得使用公开演示值 albedo-demo-2026。
DEMO_ACCESS_KEY=
# 密码中的 @ ! # 等特殊字符必须 URL 编码（urllib.parse.quote）。
# 下面的密码需与 MYSQL_PASSWORD / REDIS_PASSWORD 保持一致。
DATABASE_URL=mysql+aiomysql://albedo:CHANGE_ME_DB_PASSWORD@mysql:3306/albedo
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CHECKPOINT_BACKEND=redis

# ==================== 上游模型（production 强制非空）====================
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# 留空复用 LLM_MODEL
VISION_MODEL=

# ==================== 腾讯云 COS（Skill 包权威存储）====================
# production 下 SKILL_STORAGE=cos 时密钥必填，缺失会拒绝启动。
SKILL_STORAGE=cos
COS_BUCKET=albedo-1305182252
COS_REGION=ap-nanjing
COS_SECRET_ID=
COS_SECRET_KEY=
COS_TOKEN=
COS_ENDPOINT=
COS_SCHEME=https
COS_PREFIX=skills
COS_TIMEOUT_SECONDS=30

# ==================== 站点与安全 ====================
# 硬约束：前端把 API 写死为同源相对路径 /api/v1，认证依赖 HttpOnly 会话 cookie
# 与 albedo_csrf 双提交。你的前端网关必须把 /api/ 与 /v1/ 反代到后端保持同源。
# 前后端若不同源（不同站点），POST 会因 SameSite=Lax 丢 cookie、写操作读不到
# CSRF cookie 而 403；这种形态需要改代码，请勿直接跨域直连后端端口。
PLATFORM_DOMAIN=https://your.domain
CORS_ORIGINS=https://your.domain
# 对外必须 HTTPS，由你的前端网关/负载均衡终止 TLS。
COOKIE_SECURE=true
CSRF_ENABLED=true
ENVIRONMENT=production

# 本机 / 内网纯 HTTP 联调时可临时降级为：
#   ENVIRONMENT=dev
#   COOKIE_SECURE=false
#   CSRF_ENABLED=false
#   PLATFORM_DOMAIN=http://localhost:5173
#   CORS_ORIGINS=http://localhost:5173
