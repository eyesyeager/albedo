# ==========================================================================
# 前端构建期变量模板（脱敏，提交 Git）
# 用法：复制为 .env 并填入真实值（真实 .env 已被 .gitignore 忽略）
#   cp .env.example .env
# 🔴 仅允许放地址类配置；禁止放任何密钥、Token、业务配置：
#    - 业务可变值 → GET /api/v1/sys-config（configStore）
#    - 租户品牌文案 → GET /api/v1/site/config（siteStore）
#    - 静态 UI 文案 → src/locales/
# ==========================================================================

# 后端 API 域名前缀；留空时生产按 albedo-{tenant} → api-albedo-{tenant} 运行时推导，本地走 Vite proxy 同源
VITE_API_DOMAIN=

# 耶瞳用户中心地址与应用 clientId（前端发起授权跳转用）
VITE_SSO_URL=https://user.eyescode.top
VITE_SSO_CLIENT_ID=<YOUR_SSO_CLIENT_ID>
