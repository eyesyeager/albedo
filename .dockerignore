# 构建上下文是仓库根目录；两个 Dockerfile 都从这里 COPY。
.git
.gitignore
.codebuddy
**/node_modules
**/dist
**/.vite
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache

# 任何真实凭据都不得进入镜像
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!deploy/.env.example
deploy/.env

# 后端运行时产物由 named volume 提供
backend/var
backend/*.pid
backend/cookies.txt
backend/pyproject.toml.bak

# 文档、图片与测试不需要进镜像
docs
**/*.md
backend/tests
backend/scripts/e2e
frontend/src/**/*.test.*
